# zmemory mesh — client credentials sample.
# Copy to ~/.secrets.d/zmemory-mesh.env and `chmod 600`. NEVER commit real values.
#
#   cp integrations/zmemory-mesh.env.sample ~/.secrets.d/zmemory-mesh.env
#   chmod 600 ~/.secrets.d/zmemory-mesh.env
#   # then fill in the bearer (the MEMORY_BEARER configured on the gateway)
#
# All mesh clients (CLI hook, Pi adapter, Desktop wrapper, mesh_router) read
# these two values from the environment, falling back to this file.

# Public edge of the memory-core gateway (Cloudflare tunnel -> avm-02:8848).
ZMEMORY_GATEWAY_URL=https://memory.finn.qzz.io

# Bearer token (server-side MEMORY_BEARER). Keep secret; never commit.
ZMEMORY_BEARER_TOKEN=replace-with-bearer-token
